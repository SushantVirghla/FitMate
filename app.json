{
  "expo": {
    "name": "FitMate",
    "slug": "todoList",
    "description": "Workout Tracker and Nutrition Tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.todoList"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.FitMate"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "runtimeVersion": "1.0.0",
    "owner": "sushantvirghla",
    "extra": {
      "eas": {
        "projectId": "593a2880-b560-4a27-8422-cca80eaeaa81"
      }
    }
  }
}
